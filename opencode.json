{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/specs/layers.md",
    "docs/architecture.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "task-tracker": {
      "type": "local",
      "command": ["java", "-jar", "/home/nkamaev/.tasktracker/bin/task-tracker-mcp.jar"],
      "environment": {
        "TASKTRACKER_BASE_URL": "http://localhost:8765/api/v1",
        "TASKTRACKER_ACTOR": "mcp:claude-code"
      }
    }
  },
  "agent": {
    "plan": {
      "description": "Analyze and plan changes without modifying files",
      "mode": "primary",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    },
    "build": {
      "description": "Full development with all tools enabled",
      "mode": "primary"
    },
    "architect": {
      "description": "Architecture planning, module structure, data models, Flyway migrations",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "backend": {
      "description": "Java 21 + Spring Boot 3.3 backend development",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "frontend": {
      "description": "React 18 + TypeScript + shadcn/ui + TipTap frontend development",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "tiptap": {
      "description": "TipTap custom extensions, ProseMirror nodes and plugins",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "test": {
      "description": "Unit (JUnit/Vitest), integration (Testcontainers), and E2E (Playwright) tests",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "review": {
      "description": "Code review — checks architecture, conventions, and quality",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task-tracker_*": "allow"
      }
    },
    "debug": {
      "description": "Bug diagnosis and fixing",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "devops": {
      "description": "Docker, CI/CD, infrastructure config",
      "mode": "subagent"
    },
    "ui-migration": {
      "description": "Migrate Ant Design → shadcn/ui + Tailwind",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "task": {
      "description": "Task management via task-tracker MCP",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "migrate": {
      "description": "Database migrations (Flyway) and data migration scripts",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    }
  }
}
