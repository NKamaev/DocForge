{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/specs/layers.md",
    "docs/architecture.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "environment": {
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/home/nkamaev/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome"
      }
    },
    "task-tracker": {
      "type": "local",
      "command": ["java", "-jar", "/home/nkamaev/.tasktracker/bin/task-tracker-mcp.jar"],
      "environment": {
        "TASKTRACKER_BASE_URL": "http://localhost:8765/api/v1",
        "TASKTRACKER_ACTOR": "mcp:claude-code"
      }
    },
    "github": {
      "type": "local",
      "command": ["/home/nkamaev/.local/bin/docforge-github-mcp.sh"],
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "description": "Analyze and plan changes without modifying files",
      "mode": "primary",
      "permission": {
        "write": "deny",
        "edit": "deny"
      }
    },
    "build": {
      "description": "Full development: COORDINATOR that delegates complex/cross-domain tasks to subagents but CAN implement small pattern-based changes (1-5 files) directly when context is already loaded.",
      "mode": "primary"
    },
    "architect": {
      "description": "Architecture planning, module structure, data models, Flyway migration skeletons. DELEGATES implementation to backend/frontend agents.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "backend": {
      "description": "Java 21 + Spring Boot 3.3 backend development",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "frontend": {
      "description": "React 18 + TypeScript + shadcn/ui + TipTap frontend development",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "tiptap-specialist": {
      "description": "TipTap custom extensions, ProseMirror nodes and plugins",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "test": {
      "description": "Unit (JUnit/Vitest), integration (Testcontainers), and E2E (Playwright) tests",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "review": {
      "description": "Code review — checks architecture, conventions, and quality",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "task-tracker_*": "allow"
      }
    },
    "debug": {
      "description": "Bug diagnosis and fixing",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "devops": {
      "description": "Docker, CI/CD, infrastructure config",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "ui-migration": {
      "description": "Migrate Ant Design → shadcn/ui + Tailwind",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow",
        "playwright_*": "allow"
      }
    },
    "task": {
      "description": "Task management via task-tracker MCP",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "migrate": {
      "description": "Database migrations (Flyway) and data migration scripts",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "template-architect": {
      "description": "Templates, parameters, conditions, questionnaire design",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "document-collab-specialist": {
      "description": "Yjs CRDT, WebSocket collaboration, document export (DOCX/PDF)",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "format-engineer": {
      "description": "Parameter formatting (FIO, dates, numbers, currency), locale support",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    },
    "layer-architect": {
      "description": "Analyze layer boundaries and contracts; enforce modular architecture rules",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow",
        "context7_*": "allow"
      }
    },
    "feedback-sync": {
      "description": "Sync bug reports from audit_log to TaskTracker",
      "mode": "subagent",
      "permission": {
        "task-tracker_*": "allow"
      }
    }
  }
}
